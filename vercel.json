{
  "redirects": [
    {
      "source": "/category/:slug/",
      "destination": "/:slug/",
      "permanent": true
    },
    {
      "source": "/category/:slug",
      "destination": "/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
